{% extends '_layout.html.twig' %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Flows</h2>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th scope="col">Flow</th>
                    <th scope="col">Worked Jobs</th>
                    <th scope="col">Errored Jobs</th>
                    <th scope="col">Total Jobs</th>
                    <th scope="col">Description</th>
                    <th scope="col">Producer</th>
                    <th scope="col">Worker</th>
                </tr>
                </thead>
                <tbody>
                {% for flow in flows %}
                    <tr>
                        <th scope="row">
                            <a href="/flow/{{ flow.code }}" class="link-body-emphasis text-decoration-none fw-semibold">
                                {{ flow.code }}
                            </a>
                        </th>
                        <td>
                            <a href="/flow/{{ flow.code }}?query=lastEvent.type.keyword:worked" class="badge text-bg-success text-decoration-none">
                                {{ flow.workedJobs }}
                            </a>
                        </td>
                        <td>
                            <a href="/flow/{{ flow.code }}?query=lastEvent.type.keyword:errored" class="badge text-bg-warning text-decoration-none">
                                {{ flow.erroredJobs }}
                            </a>
                        </td>
                        <td>
                            <a href="/flow/{{ flow.code }}" class="badge text-bg-secondary text-decoration-none">
                                {{ flow.totalJobs }}
                            </a>
                        </td>
                        <td class="text-body-secondary">{{ flow.description }}</td>
                        <td><code class="small">{{ flow.producer }}</code></td>
                        <td><code class="small">{{ flow.worker }}</code></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
