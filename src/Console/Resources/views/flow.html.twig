{% extends '_layout.html.twig' %}

{% block content %}
    <div class="d-flex align-items-center gap-3 mb-3">
        <a class="btn btn-outline-secondary" role="button" href="/">
            <i class="bi bi-arrow-left-circle"></i> Back
        </a>
        <h2 class="mb-0">
            Flow <small class="text-body-secondary">{{ flowCode }}</small>
        </h2>
        {% if canRun %}
            <form action="/flow/{{ flowCode }}/run" method="post" class="ms-auto"
                  onsubmit="return confirm('Run the producer for &quot;{{ flowCode }}&quot; now?');">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-play-fill"></i> Run now
                </button>
            </form>
        {% else %}
            <button type="button" class="btn btn-secondary ms-auto" disabled
                    title="HTTP request producers cannot be run manually">
                <i class="bi bi-play-fill"></i> Run now
            </button>
        {% endif %}
    </div>

    {% if massActionSuccess == 'requeue' %}
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            {% if massActionCount is not defined %}
                Selected jobs has been successfully re-queued!
            {% else %}
                {{ massActionCount }} selected job(s) has been successfully re-queued!
            {% endif %}
        </div>
    {% endif %}

    {% if ran %}
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            Producer ran successfully: {{ ranCount }} job(s) produced.
        </div>
    {% endif %}

    <div class="card shadow-sm my-3">
        <div class="card-body">
            <form action="/flow/{{ flowCode }}" method="get">
                <label for="query" class="form-label fw-semibold">Search</label>
                <input type="search"
                       class="form-control form-control-lg"
                       id="query"
                       aria-describedby="queryHelp"
                       placeholder="Enter a query"
                       name="query"
                       value="{{ query }}">
                <div id="queryHelp" class="form-text">
                    Search for jobs in this flow
                    (use <a href="https://lucene.apache.org/core/2_9_4/queryparsersyntax.html" target="_blank">Lucene query syntax</a>).
                </div>
            </form>
        </div>
    </div>

    {% if pager.getCurrentPageResults|length > 0 %}
        <form action="/flow/{{ flowCode }}/mass-action?query={{ query|url_encode }}&page={{ pager.getCurrentPage }}" method="POST">
            <div class="navbar navbar-expand-lg bg-body-tertiary rounded-top border sticky-top">
                <div class="container-fluid">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-check2-square"></i>
                                <span data-selected-count="">0</span> selected
                            </a>
                            <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <a class="dropdown-item" href="#" onclick="selectAll(); return false;">Select All</a>
                                <a class="dropdown-item" href="#" onclick="unselectAll(); return false;">Unselect All</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#" onclick="selectVisible(); return false;">Select Visible</a>
                                <a class="dropdown-item" href="#" onclick="unselectVisible(); return false;">Unselect Visible</a>
                            </div>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center ms-auto">
                        <input type="hidden" data-remaining-count="{{ pager.getNbResults - pager.getCurrentPageResults|length }}" name="remaining-selected" value="" />
                        <button type="submit" name="job-select-action" value="requeue" class="btn btn-secondary" disabled="disabled">
                            <i class="bi bi-arrow-clockwise"></i>
                            Requeue <span data-selected-count="">0</span> job(s)
                        </button>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm rounded-top-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col">Job ID</th>
                            <th scope="col">Job Payload</th>
                            <th scope="col">Job Last Event</th>
                            <th scope="col">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for job in pager.getCurrentPageResults %}
                            <tr>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input position-static job-select-control" type="checkbox"
                                               name="selected[]" value="{{ job.uuid }}" aria-label="...">
                                    </div>
                                </td>
                                <th scope="row"><code class="small">{{ job.uuid }}</code></th>
                                {% set payload = job.payloadData|json_encode() %}
                                <td><code class="small">{{ payload|length > 70 ? payload|slice(0, 70) ~ '...' : payload }}</code></td>
                                <td><span class="badge text-bg-light border">{{ job.lastEvent.type }}</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Actions">
                                        <a class="btn btn-outline-primary" href="/flow/{{ flowCode }}/job/{{ job.uuid }}">
                                            <i class="bi bi-eye"></i>
                                            View
                                        </a>
                                        <a class="btn btn-outline-secondary" href="/flow/{{ flowCode }}/job/{{ job.uuid }}/requeue">
                                            <i class="bi bi-arrow-clockwise"></i>
                                            Requeue
                                        </a>
                                        {% if job.lastEvent.type not in ['worked', 'cancelled'] %}
                                            {# This button is not a <form> on purpose: it lives inside the mass-action
                                               form above, and nested <form> elements are invalid HTML. #}
                                            <button type="button" class="btn btn-outline-danger"
                                                    onclick="cancelJob('{{ flowCode }}', '{{ job.uuid }}'); return false;">
                                                <i class="bi bi-x-circle"></i>
                                                Cancel
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    {% endif %}

    <div class="d-flex justify-content-center">
        {{ pagerfanta(pager, '/flow/'~ flowCode ~'?query=' ~ query|url_encode ~ '&page={page}') }}
    </div>

    <script type="text/javascript">
        function cancelJob(flow, jobId) {
            if (!confirm('Cancel this job? This only works if it has not started yet.')) {
                return;
            }
            fetch('/flow/' + encodeURIComponent(flow) + '/job/' + encodeURIComponent(jobId) + '/cancel', {
                method: 'POST'
            }).then(function () {
                window.location.reload();
            });
        }

        document.onreadystatechange = function () {
            if (document.readyState === "complete") {
                document.querySelectorAll('.job-select-control').forEach(function (el) {
                    el.addEventListener('change', updateSelectionState);
                });
            }
        };

        function updateSelectionState() {
            var checkboxes = document.querySelectorAll('.job-select-control:checked');
            var selected = checkboxes.length;
            var countDisplay = document.querySelectorAll('[data-selected-count]');

            countDisplay.forEach(function (el) {
                el.textContent = selected;
            });

            var remainingInput = document.querySelector('input[name="remaining-selected"]');
            if (remainingInput && remainingInput.value) {
                var remaining = parseInt(remainingInput.dataset.remainingCount, 10) || 0;
                selected += remaining;

                countDisplay.forEach(function (el) {
                    el.textContent = selected;
                });
            }

            var actionButtons = document.querySelectorAll('button[name="job-select-action"]');
            actionButtons.forEach(function (btn) {
                btn.disabled = selected === 0;
            });
        }

        function selectVisible() {
            document.querySelectorAll('.job-select-control').forEach(function (el) {
                el.checked = true;
            });
            updateSelectionState();
        }

        function unselectVisible() {
            document.querySelectorAll('.job-select-control').forEach(function (el) {
                el.checked = false;
            });
            updateSelectionState();
        }

        function selectAll() {
            document.querySelectorAll('.job-select-control').forEach(function (el) {
                el.checked = true;
            });
            var remainingInput = document.querySelector('input[name="remaining-selected"]');
            if (remainingInput) {
                remainingInput.value = '1';
            }
            updateSelectionState();
        }

        function unselectAll() {
            document.querySelectorAll('.job-select-control').forEach(function (el) {
                el.checked = false;
            });
            var remainingInput = document.querySelector('input[name="remaining-selected"]');
            if (remainingInput) {
                remainingInput.value = '';
            }
            updateSelectionState();
        }
    </script>
{% endblock %}
