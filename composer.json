{
    "name": "webgriffe/esb",
    "description": "Simple, beanstalkd powered, ESB framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Webgriffe SRL",
            "email": "support@webgriffe.com"
        }
    ],
    "require": {
        "php": "~8.1.0|~8.2.0|~8.3.0|~8.4.0|~8.5.0",
        "ext-pcntl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/yaml": "^5.4",
        "amphp/beanstalk": "^0.3.2",
        "monolog/monolog": "^3.0",
        "dragonmantank/cron-expression": "^3.3",
        "twig/twig": "^3.14",
        "nikic/fast-route": "^1.3",
        "amphp/http-server": "^2.1",
        "amphp/amp": "^2.6",
        "psr/log": "^2.0|^3.0",
        "amphp/socket": "^1.2",
        "amphp/http": "^1.7",
        "amphp/file": "^2.0",
        "webmozart/assert": "^1.11",
        "symfony/serializer": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/property-info": "^6.4",
        "ramsey/uuid": "^4.7",
        "webgriffe/amp-elasticsearch": "^2.4",
        "pagerfanta/pagerfanta": "^4.0",
        "symfony/deprecation-contracts": "^3.0",
        "amphp/http-server-form-parser": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Webgriffe\\Esb\\": ["src/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webgriffe\\Esb\\": ["tests/"]
        }
    },
    "bin": [
        "bin/esb"
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "amphp/phpunit-util": "^1.0",
        "pda/pheanstalk": "^5.0",
        "mikey179/vfsstream": "^1.6.11",
        "amphp/http-client": "^4.6",
        "phpstan/phpstan": "^2.3",
        "symplify/easy-coding-standard": "^13.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "scripts": {
        "ecs": "vendor/bin/ecs",
        "phpstan": "vendor/bin/phpstan analyse --no-progress -c phpstan.neon",
        "phpunit": "vendor/bin/phpunit",
        "tests": ["@ecs", "@phpstan", "@phpunit"]
    }
}
